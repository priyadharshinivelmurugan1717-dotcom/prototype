v><div id=\"view\"></div></main><footer>Independent department-store prototype • Sample catalogue and clearly labelled demo reviews<br>Customer feedback analysis uses rule-based NLP. Purchases and checkout are outside this prototype.</footer><script>\nconst $=id=>document.getElementById(id);let floors=[],selected=null,activeFloor=null,requestId=0;\nfunction el(tag,text,cls){const n=document.createElement(tag);if(text!==undefined)n.textContent=text;if(cls)n.className=cls;return n}function status(t){$('status').textContent=t}async function api(path,method='GET',data){const r=await fetch(path,{method,headers:data?{'Content-Type':'application/json'}:{},body:data?JSON.stringify(data):undefined});const j=await r.json();if(!r.ok)throw Error(j.message||'Request failed');return j}function stars(n){return '★'.repeat(n)+'☆'.repeat(5-n)}function reset(){requestId++;$('view').replaceChildren();status('');window.scrollTo(0,0)}function breadcrumb(f,p){const row=el('div',undefined,'crumb'),home=el('button','All floors');home.onclick=showHome;row.append(home);if(f){const b=el('button','Floor '+f.id+' · '+f.name);b.onclick=()=>showFloor(f);row.append(b)}if(p)row.append(el('span',p.name,'muted'));$('view').append(row)}\nfunction showHome(){selected=null;activeFloor=null;reset();const hero=el('section',undefined,'hero'),intro=el('div');intro.append(el('div','YOUR STORE, FLOOR BY FLOOR','eyebrow'),el('h1','Seven floors. Endless discoveries.'),el('p','Explore our departments, discover products and hear from customers before you choose.','muted'));const building=el('div',undefined,'building');[...floors].reverse().forEach(f=>building.append(el('div','F'+f.id+' · '+f.name)));hero.append(intro,building);$('view').append(hero,el('h2','Choose your floor'),el('p','Every department has its own collection. Select a floor to browse its products.','muted'));const grid=el('div',undefined,'grid');floors.forEach(f=>{const b=el('button',undefined,'tile');b.append(el('span','FLOOR 0'+f.id,'pill'),el('span',f.icon,'icon'),el('h3',f.name),el('span',f.description,'muted'),el('span',f.products.length+' products · Explore floor →','link'));b.onclick=()=>showFloor(f);grid.append(b)});$('view').append(grid)}\nfunction showFloor(f){activeFloor=f;selected=null;reset();breadcrumb(f);$('view').append(el('div','FLOOR 0'+f.id,'eyebrow'),el('h1',f.name),el('p',f.description+'. Click a product icon to see its customer reviews.','muted'));const grid=el('div',undefined,'grid');f.products.forEach(p=>{const b=el('button',undefined,'tile');b.setAttribute('aria-label','Read reviews for '+p.name);b.append(el('div',p.icon,'product-art'),el('h3',p.name),el('span',p.description,'muted'),el('div','₹'+p.price.toLocaleString('en-IN'),'price'),el('span','Read customer reviews →','link'));b.onclick=()=>showProduct(f,p);grid.append(b)});$('view').append(grid)}\nasync function showProduct(f,p){activeFloor=f;selected=p;reset();const token=requestId;breadcrumb(f,p);const split=el('div',undefined,'split'),left=el('div'),info=el('section',undefined,'card');info.append(el('div',p.icon,'product-art large'),el('div','FLOOR '+f.id+' · '+f.name,'eyebrow'),el('h2',p.name),el('p',p.description,'muted'),el('div','₹'+p.price.toLocaleString('en-IN'),'price'),el('p','Sample product • Store discovery and review prototype','note'));left.append(info);const form=el('form',undefined,'card');form.append(el('h3','Share your experience'));const name=el('input');name.id='customer';name.maxLength=60;name.required=true;const nameLabel=el('label','Your name');nameLabel.htmlFor=name.id;const rating=el('select');rating.id='rating';[5,4,3,2,1].forEach(n=>rating.add(new Option(n+' stars',n)));const ratingLabel=el('label','Your rating');ratingLabel.htmlFor=rating.id;const text=el('textarea');text.id='review';text.required=true;text.maxLength=3000;text.placeholder='How was the quality, fit or overall experience?';const reviewLabel=el('label','Your review');reviewLabel.htmlFor=text.id;const submit=el('button','Submit review','primary');submit.type='submit';form.append(nameLabel,name,ratingLabel,rating,reviewLabel,text,submit,el('div','Reviews are public in this local demo. Your name and review appear below.','note'));form.onsubmit=async e=>{e.preventDefault();submit.disabled=true;try{await api('/api/products/'+p.id+'/reviews','POST',{name:name.value,rating:Number(rating.value),text:text.value});if(selected?.id===p.id){await showProduct(f,p);status('Thank you! Your review was saved for '+p.name+'.')}}catch(e){status(e.message);submit.disabled=false}};left.append(form);const right=el('section',undefined,'card');right.append(el('h2','Customer reviews'),el('div','Loading reviews…','muted'));split.append(left,right);$('view').append(split);try{const data=await api('/api/products/'+p.id+'/reviews');if(token!==requestId)return;renderReviews(right,data)}catch(e){if(token===requestId){right.replaceChildren(el('h2','Customer reviews'),el('p','Unable to load reviews.'));status(e.message)}}}\nfunction renderReviews(target,data){target.replaceChildren(el('h2','Customer reviews'));const all=data.reviews,avg=all.length?(all.reduce((s,r)=>s+r.rating,0)/all.length).toFixed(1):'—';const stats=el('div',undefined,'stats');[[avg+' / 5','Average rating'],[all.length,'Reviews'],[all.filter(r=>r.sentiment==='Positive').length,'Positive feedback']].forEach(([n,l])=>{const d=el('div');d.append(el('strong',String(n)),el('small',l));stats.append(d)});target.append(stats);const issues={};all.forEach(r=>r.topics.filter(t=>t.negative).forEach(t=>issues[t.name]=(issues[t.name]||0)+1));const top=Object.entries(issues).sort((a,b)=>b[1]-a[1]);target.append(el('p',top.length?'Review insight: '+top[0][0]+' is mentioned with concerns in '+top[0][1]+' review(s).':'Review insight: no negative topic signals detected.','muted'));const demoCount=all.filter(r=>r.demo).length;if(demoCount)target.append(el('p',demoCount+' sample reviews are included to demonstrate this product page. Customer submissions are labelled separately.','note'));const filters=el('div',undefined,'filters'),search=el('input');search.placeholder='Search these reviews';search.setAttribute('aria-label','Search product reviews');const filter=el('select');filter.setAttribute('aria-label','Filter reviews by rating');filter.add(new Option('All ratings',''));[5,4,3,2,1].forEach(n=>filter.add(new Option(n+' stars',n)));filters.append(search,filter);const list=el('div');target.append(filters,list);function draw(){list.replaceChildren();const rows=all.filter(r=>(!filter.value||r.rating===Number(filter.value))&&r.text.toLowerCase().includes(search.value.toLowerCase()));if(!rows.length)list.append(el('div','No matching reviews.','empty'));rows.slice().reverse().forEach(r=>{const d=el('article',undefined,'review');d.append(el('strong',r.name),el('span',r.demo?'Demo review':'Customer submission','badge'),el('div',stars(r.rating),'stars'),el('p',r.text),el('span',r.sentiment+' · '+r.priority+' priority','badge '+r.sentiment),el('div',new Date(r.date).toLocaleDateString()+' · Topics: '+r.topics.map(t=>t.name).join(', '),'note'));list.append(d)})}search.oninput=draw;filter.onchange=draw;draw()}\n$('home').onclick=showHome;api('/api/catalog').then(data=>{floors=data.floors;showHome()}).catch(e=>status('Could not load store: '+e.message));\n</script></body></html>";
const FILE=process.env.STORE_DATA_FILE||path.join(__dirname,'store-reviews.json');
const products=CATALOG.flatMap(f=>f.products);const demo=[];
for(const p of products){[['Ananya',5,'The product quality is excellent. Happy with this purchase.'],['Karthik',3,'The product is good but packaging was damaged.'],['Meena',4,'Great value and helpful staff.']].forEach(([name,rating,text])=>demo.push({...analyze(text),id:crypto.randomUUID(),productId:p.id,name,rating,demo:true}));}
function read(){if(!fs.existsSync(FILE))return [];const data=JSON.parse(fs.readFileSync(FILE,'utf8'));if(!Array.isArray(data))throw Error('Invalid review data');return data}
function save(rows){fs.writeFileSync(FILE+'.tmp',JSON.stringify(rows,null,2));fs.renameSync(FILE+'.tmp',FILE)}
function send(res,status,data,type='application/json'){res.writeHead(status,{'Content-Type':type+'; charset=utf-8','X-Content-Type-Options':'nosniff'});res.end(type==='application/json'?JSON.stringify(data):data)}
async function body(req){let chunks=[],size=0;for await(const c of req){size+=c.length;if(size>20000)throw Object.assign(Error('Review request is too large.'),{status:413});chunks.push(c)}try{return JSON.parse(Buffer.concat(chunks).toString())}catch{throw Object.assign(Error('Invalid JSON.'),{status:400})}}
const server=http.createServer(async(req,res)=>{try{const route=new URL(req.url,'http://localhost').pathname;
if(req.method==='GET'&&route==='/'){send(res,200,HTML,'text/html');return}
if(req.method==='GET'&&route==='/api/catalog'){send(res,200,{floors:CATALOG});return}
const match=route.match(/^\/api\/products\/([a-z0-9]+)\/reviews$/);if(match){const id=match[1];if(!products.some(p=>p.id===id)){send(res,404,{message:'Product not found.'});return}
if(req.method==='GET'){send(res,200,{reviews:demo.concat(read()).filter(r=>r.productId===id)});return}
if(req.method==='POST'){const b=await body(req);if(typeof b.name!=='string'||!b.name.trim()||b.name.trim().length>60||typeof b.text!=='string'||!b.text.trim()||b.text.length>3000||!Number.isInteger(b.rating)||b.rating<1||b.rating>5){send(res,400,{message:'Enter a name (up to 60 characters), review (up to 3,000 characters), and rating from 1 to 5.'});return}const rows=read();if(rows.length>=5000){send(res,400,{message:'Demo storage limit reached.'});return}const r={...analyze(b.text.trim()),id:crypto.randomUUID(),productId:id,name:b.name.trim(),rating:b.rating,demo:false};rows.push(r);save(rows);send(res,201,{review:r});return}}
send(res,404,{message:'Not found.'});}catch(e){console.error(e.message);send(res,e.status||500,{message:e.status?e.message:'Unable to read or save reviews. Check server folder permissions.'})}});
server.listen(Number(process.env.PORT||5000),'127.0.0.1',()=>console.log('Seven Floors store: http://localhost:'+(process.env.PORT||5000)));server.on('error',e=>{console.error(e.message);process.exitCode=1});
