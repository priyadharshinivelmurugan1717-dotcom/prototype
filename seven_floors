const positives=new Set('good great excellent amazing awesome perfect love loved best fast happy satisfied nice wonderful helpful affordable durable easy smooth recommend responsive secure'.split(' '));
const negatives=new Set('bad poor worst late slow damaged broken terrible hate expensive delayed delay issue problem disappointed defective rude ignored crash crashes bug overpriced useless difficult unsafe'.split(' '));
function signals(text){const tokens=text.toLowerCase().replace(/n’t|n't/g,' not').match(/[a-z]+|[.,;!?]/g)||[];let pos=0,neg=0;const evidence=[];tokens.forEach((w,i)=>{let val=positives.has(w)?1:negatives.has(w)?-1:0;if(!val)return;let prior=[];for(let j=i-1;j>=Math.max(0,i-3);j--){if(/[.,;!?]/.test(tokens[j])||['but','however'].includes(tokens[j]))break;prior.push(tokens[j])}if(prior.some(t=>['not','never','no','hardly'].includes(t)))val*=-1;if(val>0)pos++;else neg++;evidence.push((val>0?'+ ':'− ')+w)});if(/\b(did not|didn't|never|no)\s+(respond|response|reply)\b/i.test(text)){neg++;evidence.push('− no response')}return {pos,neg,evidence}}
function analyze(text){const s=signals(text);const sentiment=s.pos&&s.neg?'Mixed':s.pos?'Positive':s.neg?'Negative':'Neutral';const clauses=text.split(/[.!?;]|\bbut\b|\bhowever\b/i).filter(Boolean);const topics=config.filter(c=>c[1].test(text.toLowerCase())).map(c=>{const relevant=clauses.filter(x=>c[1].test(x.toLowerCase()));return {name:c[0],negative:relevant.some(x=>signals(x).neg>0),positive:relevant.some(x=>signals(x).pos>0)}});if(!topics.length)topics.push({name:'General Feedback',negative:s.neg>0,positive:s.pos>0});const severe=/\b(unsafe|broken|defective|terrible|worst|ignored)\b/i.test(text)&&s.neg>0;const priority=severe||s.neg>=3?'High':s.neg?'Medium':'Low';return {id:globalThis.crypto?.randomUUID?.()||Date.now()+'-'+Math.random(),text,sentiment,priority,topics,evidence:s.evidence,date:new Date().toISOString()}}

