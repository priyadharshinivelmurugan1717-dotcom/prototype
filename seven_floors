const HTML="<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Seven Floors | Store & Customer Reviews</title><style>\n*{box-sizing:border-box}body{margin:0;background:#faf7f2;color:#283c35;font:15px system-ui,sans-serif}header{background:#fff;border-bottom:1px solid #e4e6de;padding:19px 5%;display:flex;justify-content:space-between;align-items:center}.brand{font-size:24px;font-weight:850;letter-spacing:-1px}.brand span{color:#be873e}button,input,select,textarea{font:inherit}button{cursor:pointer;border:1px solid #d9dfd6;background:white;color:#283c35;padding:11px 17px;border-radius:9px}button:hover{border-color:#a47637;box-shadow:0 3px 15px #283c3514}button:focus-visible,a:focus-visible{outline:3px solid #a47637}.primary{background:#294c3e;color:white;border-color:#294c3e}main{max-width:1220px;margin:auto;padding:35px 22px}h1{font:700 46px Georgia,serif;margin:15px 0}h2{font-size:27px;margin:12px 0}h3{font-size:19px;margin:12px 0}.eyebrow{letter-spacing:3px;font-size:11px;font-weight:800;color:#987039}.muted{color:#728077;line-height:1.7}.hero{border-radius:20px;padding:34px;background:#e9eee5;display:flex;justify-content:space-between;gap:25px;margin-bottom:35px}.building{display:grid;gap:5px;min-width:190px}.building div{background:#fff9;padding:5px 25px;border-left:4px solid #bd955d;font-size:12px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:19px}.tile{background:white;border:1px solid #e3e7df;border-radius:15px;padding:24px;text-align:left;display:block;width:100%}.tile .icon{font-size:48px;margin:8px 0 20px;display:block}.pill{font-size:11px;color:#987039;font-weight:800;letter-spacing:1px}.tile .muted{display:block;min-height:48px}.link{display:block;margin-top:19px;color:#294c3e;font-weight:700}.crumb{display:flex;gap:10px;align-items:center;margin-bottom:22px}.product-art{height:150px;display:grid;place-items:center;background:#f3eee5;border-radius:10px;f